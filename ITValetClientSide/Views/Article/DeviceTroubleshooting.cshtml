@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_UserSideLayout.cshtml";
}
<div class="container p-5" style="background-color: #f9f9f9; border-radius: 8px; padding: 30px; margin-top:30px; box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.1);">
    <div class="row">
        <div class="col-12">
            <h1 style="font-family: 'Myriad Pro', Arial, sans-serif; font-size: 36px; font-weight: 900; color: #333;">Device Troubleshooting – Fixing Everyday Technology Hassles</h1>
            <p style="font-family: 'Myriad Pro', Arial, sans-serif; font-size: 18px; line-height: 1.6; color: #555;">
                The devices you have in your possession play a big part in your everyday routine. However, if they do not function as planned, it can be rather annoying. Despite the hurdles of nonresponsive gadgets, software crashes, poor connectivity, or problems with hardware, these challenges need not stop you. Be it a smartphone, smart wearable, or a laptop, we have you covered.
            </p>
            <br />
            <h2 style="font-family: 'Myriad Pro', Arial, sans-serif; font-size: 36px; font-weight: 900; color: #333;">Common Device Issues We Solve:</h2>
            <ul style="font-size: 18px; list-style-type: none; padding-left: 0;">
                <li style="margin-bottom: 10px; padding-left: 25px; position: relative; font-family: 'Myriad Pro', Arial, sans-serif;">
                    <span style="color: #007BFF; position: absolute; left: 0; top: 0;">•</span> Slow or unresponsive devices due to background apps or outdated software.
                </li>
                <li style="margin-bottom: 10px; padding-left: 25px; position: relative; font-family: 'Myriad Pro', Arial, sans-serif;">
                    <span style="color: #007BFF; position: absolute; left: 0; top: 0;">•</span> Connectivity issues with Wi-Fi, Bluetooth, or networks.
                </li>
                <li style="margin-bottom: 10px; padding-left: 25px; position: relative; font-family: 'Myriad Pro', Arial, sans-serif;">
                    <span style="color: #007BFF; position: absolute; left: 0; top: 0;">•</span> Battery problems like quick draining or overheating.
                </li>
                <li style="margin-bottom: 10px; padding-left: 25px; position: relative; font-family: 'Myriad Pro', Arial, sans-serif;">
                    <span style="color: #007BFF; position: absolute; left: 0; top: 0;">•</span> Hardware malfunctions such as cracked screens, stuck buttons, or faulty ports.
                </li>
                <li style="margin-bottom: 10px; padding-left: 25px; position: relative; font-family: 'Myriad Pro', Arial, sans-serif;">
                    <span style="color: #007BFF; position: absolute; left: 0; top: 0;">•</span> Software glitches causing app crashes or installation errors.
                </li>
                <li style="margin-bottom: 10px; padding-left: 25px; position: relative; font-family: 'Myriad Pro', Arial, sans-serif;">
                    <span style="color: #007BFF; position: absolute; left: 0; top: 0;">•</span> Device won’t turn on or setup problems with new gadgets.
                </li>
            </ul>
            <h2 style="font-family: 'Myriad Pro', Arial, sans-serif; font-size: 36px; font-weight: 900; color: #333;">How TechValet Helps You:</h2>
            <p style="font-family: 'Myriad Pro', Arial, sans-serif; font-size: 18px; line-height: 1.6; color: #555;">
                Whether simple troubleshooting or complex installations, we make technology easy. Our team of professionals can accurately diagnose problems and fix them promptly, ensuring the devices are optimized.
            </p>
        </div>
    </div>
</div>

<!-- Call to Action Section -->
<div class="cta-container" style="text-align: center; margin-top: 40px;">
    <h3 style="font-family: 'Myriad Pro', Arial, sans-serif; font-size: 24px; font-weight: 900; color: #333;">Do not allow technology issues to interfere with your day.</h3>
    <p style="font-family: 'Myriad Pro', Arial, sans-serif; font-size: 18px; color: #555;">Connect with TechValet for gadget troubleshooting.</p>
    <a href="@Url.Action("Contact","Home")" style="background-color: #E48F01; color: #fff; padding: 15px 30px; font-size: 18px; border: none; border-radius: 5px; cursor: pointer; margin-top: 20px; transition: background-color 0.3s ease;" onmouseover="this.style.backgroundColor='#000'" onmouseout="this.style.backgroundColor='#E48F01'">
        Call Us Now
    </a>
</div>

<!-- Additional Footer Text -->
<div style="text-align: center; margin-top: 30px;">
    <p style="font-family: 'Myriad Pro', Arial, sans-serif; font-size: 16px; color: #777;">
        At TechValet, we’re committed to making technology accessible and stress-free for everyone. Reach out today and experience the joy of simplified tech!
    </p>
</div>
